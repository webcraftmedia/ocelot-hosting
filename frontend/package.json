{
  "name": "nuxt-app",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:static": "nuxt generate",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prod:start": "nuxt start",
    "test:lint": "npm run test:lint:eslint && npm run test:lint:locales && npm run test:lint:typecheck",
    "test:lint:typecheck": "vue-tsc --noEmit",
    "test:lint:eslint": "eslint --max-warnings 0 .",
    "test:lint:locales": "scripts/locales/locales.sh ./locales",
    "test:unit": "vitest run --coverage",
    "test:unit:dev": "vitest"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/image": "^1.11.0",
    "@nuxt/test-utils": "^3.19.2",
    "@nuxt/ui": "^3.3.0",
    "@nuxtjs/i18n": "^10.2.4",
    "@nuxtjs/tailwindcss": "^7.0.0-beta.0",
    "@testing-library/vue": "^8.1.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^18.0.1",
    "nuxt": "^4.0.3",
    "nuxt-svgo": "^4.2.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.32",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@iconify-json/flowbite": "^1.2.5",
    "@intlify/eslint-plugin-vue-i18n": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.3",
    "eslint": "^10.0.3",
    "eslint-config-it4c": "^0.12.0",
    "prettier": "^3.8.1",
    "vue-tsc": "^3.2.6"
  }
}
